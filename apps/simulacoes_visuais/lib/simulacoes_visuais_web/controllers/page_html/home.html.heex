<Layouts.app flash={@flash} current_path="/" wide={false}>
  <div class="py-10 sm:py-16">
    <div class="text-center max-w-2xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-base-content">
        Gêmeo Digital · Smart Brewery
      </h1>
      <p class="mt-4 text-lg text-base-content/80 leading-relaxed">
        Painéis de dados em tempo real para o Gêmeo Digital na Indústria 4.0.
        Arquitetura PON, 57 fatos, 11 FBEs e 12 regras — simulações visuais com Phoenix LiveView.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/smart-brewery"
          class="btn btn-primary btn-lg gap-2 transition-all hover:scale-[1.02] focus-ring"
        >
          Abrir painel Smart Brewery <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <p class="mt-8 text-sm text-base-content/60">
        TEC0301 PON · Simulações visuais
      </p>
    </div>
  </div>
</Layouts.app>
